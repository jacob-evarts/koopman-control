# Copy this file to a cluster-specific location, edit the paths, then:
#   source /path/to/koopman.env
#
# These may also be exported directly from a SLURM/PBS job script.

export KOOPMAN_DATA_ROOT="/shared/project/koopman-control/data"
export KOOPMAN_OUTPUT_ROOT="/scratch/$USER/koopman-control/results"
export KOOPMAN_DATASET="$KOOPMAN_DATA_ROOT/rabbit_grass_images/dataset.h5"
export KOOPMAN_WOLF_DATASET="$KOOPMAN_DATA_ROOT/wolf_rabbit_grass_images_cull03/dataset.h5"
export KOOPMAN_TUMOR_DATASET="$KOOPMAN_DATA_ROOT/tumor_tissue_images/dataset.h5"
export KOOPMAN_SIR_DATASET="$KOOPMAN_DATA_ROOT/agentic_sir_images_v2/dataset.h5"
export KOOPMAN_STROBL_DATA_ROOT="$KOOPMAN_DATA_ROOT/strobl"
export KOOPMAN_STROBL_DATASET="$KOOPMAN_STROBL_DATA_ROOT/pilot/dataset.h5"

mkdir -p "$KOOPMAN_DATA_ROOT" "$KOOPMAN_OUTPUT_ROOT" "$KOOPMAN_STROBL_DATA_ROOT"
