# Copy this file to a cluster-specific location, edit the paths, then:
#   source /path/to/koopman.env
#
# These may also be exported directly from a SLURM/PBS job script.

export KOOPMAN_DATA_ROOT="/shared/project/koopman-control/data"
export KOOPMAN_OUTPUT_ROOT="/scratch/$USER/koopman-control/results"
export KOOPMAN_DATASET="$KOOPMAN_DATA_ROOT/rabbit_grass_images/dataset.h5"
export MPLCONFIGDIR="$KOOPMAN_OUTPUT_ROOT/matplotlib-cache"

mkdir -p "$KOOPMAN_DATA_ROOT" "$KOOPMAN_OUTPUT_ROOT" "$MPLCONFIGDIR"
